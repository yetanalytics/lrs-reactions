{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}
        com.fasterxml.jackson.core/jackson-core {:mvn/version "2.18.11"}
        com.google.guava/guava {:mvn/version "32.1.3-jre"}
        com.google.protobuf/protobuf-java {:mvn/version "3.25.5"}
        com.google.code.gson/gson {:mvn/version "2.8.9"}
        org.mozilla/rhino {:mvn/version "1.7.14.1"}
        com.yetanalytics/xapi-schema {:mvn/version "1.4.1"
                                      :exclustions [org.clojure/clojure
                                                    org.clojure/clojurescript
                                                    org.clojure/data.json]}}
 :aliases
 {:build {:deps {io.github.clojure/tools.build {:mvn/version "0.9.4"}
                 slipset/deps-deploy {:mvn/version "0.2.1"}}
          :ns-default build}
  :test {:extra-paths ["test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.1"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}}}}
